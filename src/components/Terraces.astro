---
import { business } from '../config/business';
import CallButton from './CallButton.astro';
import Icon from './Icon.astro';
import TodoNote from './TodoNote.astro';

const t = business.terraces;
---

<section id="terraces" class="py-16 md:py-24">
  <div class="container-x">
    <p class="font-display text-lg font-extrabold uppercase tracking-widest text-field">What we do best</p>
    <h2 class="mt-1 text-4xl text-soil sm:text-5xl md:text-6xl">{t.heading}</h2>
    <p class="mt-4 max-w-3xl text-lg md:text-xl">{t.intro}</p>

    <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-12">
      <div class="space-y-6">
        <p class="font-display text-2xl font-extrabold uppercase text-field">When farmers call us</p>
        {
          t.situations.map((s) => (
            <article class="situation border-l-4 border-field pl-4">
              <h3 class="text-xl text-soil md:text-2xl">{s.title}</h3>
              <p class="mt-1">{s.text}</p>
            </article>
          ))
        }
      </div>

      <div class="rounded-xl bg-white/70 p-6 ring-1 ring-soil/15 md:p-8">
        <p class="font-display text-2xl font-extrabold uppercase text-field">What we build</p>
        <ul class="offerings mt-4 space-y-4">
          {
            t.offerings.map((o, i) => (
              <li class="flex gap-3">
                <Icon name="check" class="mt-1 size-6 shrink-0 text-field" />
                <div>
                  <p class="font-semibold text-soil">{o.title}</p>
                  <p>{o.text}</p>
                  {i === 3 && <TodoNote confirmed={t.nrcsConfirmed} text="NRCS specifications and EQIP eligibility" />}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-5">
      <CallButton size="lg" onLight />
      <p class="font-semibold text-soil">Blown-out terrace or a deadline coming? Call today.</p>
    </div>
  </div>
</section>
