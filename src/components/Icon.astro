---
// Original, simple line icons (24x24, currentColor). Decorative: hidden from screen readers.
import type { IconName } from '../config/derived';

type Name = IconName | 'phone' | 'menu' | 'check' | 'map-pin';

interface Props {
  name: Name;
  class?: string;
}

const { name, class: className = 'size-6' } = Astro.props;

const paths: Record<Name, string> = {
  phone:
    '<path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a12 12 0 0 0 7.2 7.2l1.4-2.1 4.2 1.6V19a2 2 0 0 1-2 2A17 17 0 0 1 3 5.5a2 2 0 0 1 2-2Z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  check: '<path d="m4.5 12.5 4.5 4.5 10.5-11"/>',
  'map-pin':
    '<path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21Z"/><circle cx="12" cy="9.8" r="2.3"/>',
  // Perforated tile line under the ground surface
  tile: '<path d="M2 7h20"/><rect x="3" y="12" width="18" height="6" rx="3"/><path d="M7.5 15h.01M12 15h.01M16.5 15h.01"/>',
  // Grassed swale with water in the bottom
  waterway:
    '<path d="M2 8c4 0 5 8 10 8s6-8 10-8"/><path d="M8.5 14.5c1.2.6 2.3.9 3.5.9s2.3-.3 3.5-.9"/><path d="M3 5.5v2M5 5v2M19 5v2M21 5.5v2"/>',
  // Pond with ripples
  pond: '<ellipse cx="12" cy="15" rx="9.5" ry="4.5"/><path d="M8.5 15h2.5M13.5 13.5H16"/><path d="M6 9.5c1-1.5 2-2.5 3-2.5M15 7c1 0 2 1 3 2.5"/>',
  // Ditch cross-section
  ditch: '<path d="M2 8h4l3.5 8h5L18 8h4"/><path d="M10.5 13.5h3"/>',
  // Tree with a cut line (clearing)
  clearing:
    '<path d="M12 3 7 10h3l-3.5 5h11L14 10h3Z"/><path d="M12 15v3"/><path d="M4 21h16"/><path d="m17.5 17.5 3 3M20.5 17.5l-3 3"/>',
  // Graded pad with level line
  grading: '<path d="M2 18h20"/><path d="M3 18 8 11h8l5 7"/><path d="M8 11h8"/><path d="M11 6h2M12 5v2"/>',
  // Culvert pipe through an embankment
  culvert: '<path d="M2 17h5l3-7h4l3 7h5"/><circle cx="12" cy="15.5" r="2.5"/><path d="M2 20h20"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
