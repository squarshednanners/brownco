---
import { business } from '../config/business';
import { areaSummary, countyLabels } from '../config/derived';
import CallButton from './CallButton.astro';
import Icon from './Icon.astro';

const towns = business.serviceArea.towns as string[];
---

<section id="service-area" class="py-14 md:py-20">
  <div class="container-x">
    <h2 class="text-3xl text-soil sm:text-4xl">Where we work</h2>
    <p class="mt-3 max-w-3xl text-lg">
      We work {areaSummary}, including these counties:
    </p>
    <ul class="mt-6 columns-2 gap-6 sm:columns-3 md:columns-4">
      {
        countyLabels.map((c) => (
          <li class="flex items-center gap-2 break-inside-avoid py-1 font-semibold text-soil">
            <Icon name="map-pin" class="size-5 shrink-0 text-field" />
            {c}
          </li>
        ))
      }
    </ul>
    {
      towns.length > 0 && (
        <p class="mt-4">
          Towns we work in include {towns.join(', ')}.
        </p>
      )
    }
    <p class="mt-6 max-w-3xl">Not sure if you're in range? Call and ask. If we can get there, we'll come out.</p>
    <div class="mt-6">
      <CallButton size="lg" onLight />
    </div>
  </div>
</section>
